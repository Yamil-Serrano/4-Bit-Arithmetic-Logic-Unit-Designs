	(gr_text "Hardware-Minimalist 4-bit ALU\nModified 3-bit OP Code | Rev 3.3\nMade by: Neowizen"
		(at 92.02 158.62 0)
		(layer "F.SilkS")
		(uuid "52999210-be62-41b6-a31c-10d9e76734f1")
		(effects
			(font
				(size 1 1)
				(thickness 0.1)
			)
			(justify left bottom)
		)
	)
	(gr_text "NOTES:\nPlace 100nF ceramic cap\nclose to each IC.\nPlace 100uF elect. cap at\npower input connector.\nPower board with 5V.\n\n→ (arrow) indicates (LSB)\nBit numbering increases \nin arrow direction.\n\nOP CODES:\n000: A + B\n100: A - B\nX01: A NAND B\nX10: A XOR B\nX11: A NOR B"
		(at 76.962 111.76 0)
		(layer "F.SilkS")
		(uuid "6a9a000c-fd2c-47a2-8eba-d61180bc6537")
		(effects
